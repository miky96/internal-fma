/* 
 * File that contains the Typescript config to be used when running ESLint
 *
 * Is a different file from `tsconfig.json` to make sure we're only linting
 * the files our source files, which do not necesarilly need to be exactly the files we want Typescript to parse
 */
{
  "extends": "./tsconfig.json",
  "include": [
    "src/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.jsx",
    "src/**/*.js"
  ]
}
