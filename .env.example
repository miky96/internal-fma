# Copia aquest fitxer a `.env.local` i omple els valors per a desenvolupament local.
# `.env.local` esta gitignored. Els valors de produccio van als GitHub Secrets.
# La apiKey de Firebase Web es publica per disseny (no es un secret real).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Opcional: posa "true" per usar els emuladors locals de Firebase.
VITE_USE_FIREBASE_EMULATORS=false
